#set operations
#union,intersection,difference,symmetric difference
#union(|) combine all the elements from both sets without duplicates
A={10,20,30}
B={40,50,30}
print(A|B)

#intersectiom -common elements
print(A&B)

#difference -elements that exists in the first set not in the second set
print(A-B)
print(B-A)

#symmetric difference - without commom elements
print(A^B)

